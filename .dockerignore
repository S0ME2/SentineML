venv/
.venv/
env/
ENV/

# ==========================================
# Python Bytecode & Tool Caches
# ==========================================
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/

# ==========================================
# Build Artifacts & Packages
# ==========================================
build/
dist/
*.egg-info/

# ==========================================
# Local Tooling, Documentation & IDEs
# ==========================================
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
README.md
docs/

# ==========================================
# Project Infrastructure Files
# ==========================================
