# Application-only template for native development: copy to .env.local.
# Provision PostgreSQL separately; the app consumes DATABASE_URL, not POSTGRES_*.
# Docker Compose uses .env.docker.example and optional .env.local.docker instead.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Optional cache. Empty disables Redis.
REDIS_URL=
PROJECT_CACHE_TTL_SECONDS=300
